{
  "name": "observational-memory",
  "version": "0.1.0",
  "description": "Observational memory for pi — tiered, subprocess-backed memory: parallel observers feed a branch-local ledger buffer; a consolidator (Phase B) promotes the oldest observations into durable .memory/ topic files.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sonar:scan": "node --env-file-if-exists=.env scripts/sonar-scan.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.5"
  }
}
